        {"title": "选举权资格说明 - 全国人民代表大会", "url": "http://www.npc.gov.cn/", "domain": "npc.gov.cn", "published_at": "2020-10-17", "credibility": "A", "credibility_score": 97, "source_type": "knowledge", "org_type": "立法机关", "snippet": "选举法对选民资格、登记程序与选举权行使作出具体规定，与宪法第三十四条一致。"}
