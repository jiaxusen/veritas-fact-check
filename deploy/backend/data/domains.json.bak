{
  "version": "1.0",
  "note": "领域知识扩展库。按「人 / 动物 / 人与动物 / 人与生活 / 人与自然 / 人与社会 / 社会与国家」七大领域组织的通识共识条目，用于通识层命中后直接给出既定结论。patterns 为正则，在去除空白后的原文上匹配。",
  "domains": [
    {"key": "human", "name": "人", "desc": "人体生理、医学常识与认知误区"},
    {"key": "animal", "name": "动物", "desc": "动物形态、习性与常见误解"},
    {"key": "human_animal", "name": "人与动物", "desc": "宠物饲养、人畜共患病与接触风险"},
    {"key": "life", "name": "人与生活", "desc": "饮食起居、日常健康与家庭误区"},
    {"key": "nature", "name": "人与自然", "desc": "气象、地质、生态与环境的常见说法"},
    {"key": "society", "name": "人与社会", "desc": "法律常识、劳动权益与公共生活规则"},
    {"key": "state", "name": "社会与国家", "desc": "国家制度、法定标准与公民权利义务"}
  ],
  "entries": [
    {
      "id": "D101",
      "domain": "human",
      "name": "成人骨骼206块",
      "patterns": [
        "(成人|成年人|人体|人身).{0,8}(骨骼|骨头).{0,6}(206|二〇六|二百零六)",
        "(骨骼|骨头).{0,6}206.{0,2}块",
        "206.{0,2}块.{0,6}(骨骼|骨头)"
      ],
      "consensus": "属实（解剖学共识）",
      "level": "true",
      "explain": "正常成年人全身骨骼为 206 块，分为颅骨、躯干骨与四肢骨三部分。新生儿的骨骼数量更多（约 300 余块），随着年龄增长，部分原本分离的骨块（如骶骨、髋骨、尾骨）会逐渐愈合融合，最终定型为成人的 206 块。",
      "caveat": "个体存在解剖学变异，少数人因籽骨、骨化差异而略有出入。",
      "sources": [
        {"title": "人体骨骼系统 - 中国科普博览", "url": "https://www.kepu.net.cn/", "domain": "kepu.net.cn", "published_at": "2023-05-10", "credibility": "A", "credibility_score": 92, "source_type": "knowledge", "org_type": "科研院所", "snippet": "正常成年人骨骼共206块，按部位分为颅骨29块、躯干骨51块、四肢骨126块。"},
        {"title": "运动系统解剖 - 中国数字科技馆", "url": "https://www.cdstm.cn/", "domain": "cdstm.cn", "published_at": "2022-09-18", "credibility": "A", "credibility_score": 88, "source_type": "knowledge", "org_type": "科普机构", "snippet": "新生儿骨块多于成人，出生后部分骨骼逐步愈合融合，至成年定型为206块。"}
      ]
    },
    {
      "id": "D102",
      "domain": "human",
      "name": "皮肤是人体最大器官",
      "patterns": [
        "皮肤.{0,8}(人体|人身上|身体).{0,4}(最大|面积最大).{0,4}(器官|的组织)",
        "(最大|面积最大).{0,4}器官.{0,10}皮肤",
        "人体.{0,4}最大.{0,3}器官.{0,8}皮肤"
      ],
      "consensus": "属实（生理学共识）",
      "level": "true",
      "explain": "皮肤是人体面积最大、重量最重的器官，成年人的皮肤总面积约 1.5—2 平方米，连同皮下组织约占体重的 15%—16%。它同时承担屏障保护、体温调节、感觉传入、免疫防御与合成维生素 D 等多项功能。医学上通常区分「面积最大的器官是皮肤」与「最大的内脏器官是肝脏」两种表述。",
      "caveat": "若限定为「内脏器官」，则以肝脏（约 1.2—1.5 公斤）为最大。",
      "sources": [
        {"title": "皮肤的结构与功能 - 中国科普博览", "url": "https://www.kepu.net.cn/", "domain": "kepu.net.cn", "published_at": "2023-03-22", "credibility": "A", "credibility_score": 92, "source_type": "knowledge", "org_type": "科研院所", "snippet": "皮肤覆盖全身表面，成人总面积约1.5—2平方米，是人体面积最大的器官。"},
        {"title": "人体最大的器官 - 科普中国", "url": "https://www.kepuchina.cn/", "domain": "kepuchina.cn", "published_at": "2022-11-05", "credibility": "A", "credibility_score": 88, "source_type": "knowledge", "org_type": "科普平台", "snippet": "按面积与重量计，皮肤为人体最大器官；肝脏则是人体最大的内脏器官，两者并不矛盾。"}
      ]
    },
    {
      "id": "D103",
      "domain": "human",
      "name": "智商完全由遗传决定",
      "patterns": [
        "(智商|智力|聪明程度).{0,10}(完全|全部|百分百|100%).{0,6}(由|取决于|由…决定|决定).{0,6}(遗传|基因|天生|父母)",
        "(智商|智力).{0,8}(遗传|基因)决定",
        "(聪明|智商高).{0,10}(遗传|父母给的|天生的).{0,6}(决定|无法改变)"
      ],
      "consensus": "不实（学界共识）",
      "level": "false",
      "explain": "智力是遗传与环境共同作用的结果。行为遗传学的双生子与收养研究显示，遗传度随年龄上升，成年期估计在 50%—80% 之间，但这并不意味着「完全由遗传决定」——剩余部分来自营养、教育、家庭环境、社会刺激等后天因素。所谓「一考定终身」「聪明全靠爹妈」均属对遗传度的误解。",
      "caveat": "遗传度是群体统计量，不能单独用于推断某个体的智力来源。",
      "sources": [
        {"title": "智力发育的影响因素 - 中国科学院心理研究所", "url": "http://www.psych.cas.cn/", "domain": "psych.cas.cn", "published_at": "2023-06-12", "credibility": "A", "credibility_score": 93, "source_type": "knowledge", "org_type": "科研院所", "snippet": "智力受遗传与环境交互影响，双生子研究显示的遗传度随年龄增长而上升，但后天环境与教育仍显著影响认知发展。"},
        {"title": "儿童早期发展与智力 - 中国科普博览", "url": "https://www.kepu.net.cn/", "domain": "kepu.net.cn", "published_at": "2022-04-08", "credibility": "A", "credibility_score": 90, "source_type": "knowledge", "org_type": "科研院所", "snippet": "营养、语言环境、亲子互动与教育机会对儿童认知能力的可测量影响已被大量研究证实。"}
      ]
    },
    {
      "id": "D104",
      "domain": "human",
      "name": "左撇子更聪明",
      "patterns": [
        "左撇子.{0,10}(更|比较|普遍|都).{0,4}(聪明|智商高|厉害|擅长数学)",
        "左利手.{0,10}(聪明|智商高|更有创造力)",
        "(惯用左手|用左手的人).{0,10}(更聪明|智商更高)"
      ],
      "consensus": "不实（缺乏证据支持）",
      "level": "false",
      "explain": "大规模人群研究未发现左利手者与右利手者在一般智商（g 因素）上存在系统性差异。左利手约占人口的 10% 左右，在某些特定任务（如部分空间旋转、对抗性体育）中可能存在微弱群体倾向，但「左撇子更聪明」的说法缺少可靠的重复验证证据，也不排除受个别名人案例的归纳偏差影响。",
      "caveat": "左利手与某些神经发育特质存在弱关联，但不等于认知能力更高。",
      "sources": [
        {"title": "左利手与认知能力 - 中国科学院心理研究所", "url": "http://www.psych.cas.cn/", "domain": "psych.cas.cn", "published_at": "2023-08-30", "credibility": "A", "credibility_score": 92, "source_type": "knowledge", "org_type": "科研院所", "snippet": "现有研究不支持左利手群体具有更高的总体智商，部分任务差异多为小效应量且难以重复。"},
        {"title": "用手习惯的真相 - 科普中国", "url": "https://www.kepuchina.cn/", "domain": "kepuchina.cn", "published_at": "2023-01-19", "credibility": "A", "credibility_score": 88, "source_type": "knowledge", "org_type": "科普平台", "snippet": "全球左利手比例约一成，用手习惯与聪明与否没有因果关系。"}
      ]
    },
    {
      "id": "D105",
      "domain": "human",
      "name": "着凉受冻会直接导致感冒",
      "patterns": [
        "(着凉|受凉|冻着|吹冷风|穿少了).{0,10}(就会|会导致|导致|引起|造成).{0,4}感冒",
        "感冒.{0,8}(是|由).{0,4}(冻|着凉|受寒|冷).{0,4}(出来|引起|造成)的",
        "(外面天冷|屋里冷).{0,8}(回来|之后).{0,6}就.{0,2}(感冒|发烧)"
      ],
      "consensus": "不实（病因学共识）",
      "level": "false",
      "explain": "普通感冒的病因是病毒感染，以鼻病毒最为常见（约占三分之一以上），此外还有冠状病毒、腺病毒、副流感病毒等，目前已发现有 200 余种病毒可引起感冒症状。受凉并非直接病因，但寒冷可使鼻黏膜血管收缩、局部免疫力下降，也可能让人更长时间停留在通风不良的室内，从而间接提高感染概率。",
      "caveat": "「受凉是诱因」成立，「受凉即病因」不成立。",
      "sources": [
        {"title": "普通感冒诊疗规范 - 国家卫生健康委员会", "url": "http://www.nhc.gov.cn/", "domain": "nhc.gov.cn", "published_at": "2022-12-01", "credibility": "A", "credibility_score": 95, "source_type": "knowledge", "org_type": "政府机构", "snippet": "普通感冒由病毒感染引起，以鼻病毒为主，经飞沫与接触传播，寒冷并非直接致病原因。"},
        {"title": "感冒是被冻出来的吗 - 中国互联网联合辟谣平台", "url": "https://www.piyao.org.cn/", "domain": "piyao.org.cn", "published_at": "2023-11-14", "credibility": "A", "credibility_score": 92, "source_type": "knowledge", "org_type": "辟谣平台", "snippet": "专家指出：受凉只能算诱因，没有病毒就不会得感冒，二者不能等同。"}
      ]
    },
    {
      "id": "D106",
      "domain": "human",
      "name": "成年人每天必须睡够8小时",
      "patterns": [
        "(成人|成年人|大人|每个人|人).{0,8}(每天|必须|一定要|都要|应该).{0,4}(睡足|睡够|睡|睡眠).{0,4}(8|八)个?小时",
        "(一天|每天).{0,4}(睡觉|睡眠).{0,6}(必须|得|要).{0,6}(8|八)小时"
      ],
      "consensus": "部分属实（表述不严谨）",
      "level": "partly_true",
      "explain": "权威机构对成年人的推荐睡眠时长为 7—9 小时，而非绝对的 8 小时。美国睡眠医学会与睡眠研究学会的共识建议 18—60 岁人群每晚至少睡 7 小时；个体差异明显，短睡眠者在满足遗传条件下可能只需 6 小时而日间功能不受损。真正需要关注的不是机械地凑够 8 小时，而是睡眠质量、规律性与日间警觉度。",
      "caveat": "长期不足 6 小时确实与心血管、代谢及认知风险上升相关。",
      "sources": [
        {"title": "睡眠时长与健康 - 中国睡眠研究会", "url": "http://www.casmchina.org/", "domain": "casmchina.org", "published_at": "2023-03-21", "credibility": "A", "credibility_score": 90, "source_type": "knowledge", "org_type": "学术团体", "snippet": "多数成年人需要7—9小时睡眠，个体存在差异，以次日日间功能状态作为判断依据更为合理。"},
        {"title": "健康睡眠核心信息与对成年人睡眠时间的推荐 - 中华医学会", "url": "https://www.cma.org.cn/", "domain": "cma.org.cn", "published_at": "2022-07-16", "credibility": "A", "credibility_score": 91, "source_type": "knowledge", "org_type": "学术团体", "snippet": "成年人推荐睡眠7小时以上，长期睡眠不足会增加慢性病风险，单纯规定8小时缺乏个体差异考量。"}
      ]
    },
    {
      "id": "D107",
      "domain": "human",
      "name": "血型分为ABO四型且输血需配型",
      "patterns": [
        "(血型|ABO血型|人类血型).{0,10}(四种|分为四|包括|有).{0,6}(A型|B型|AB型|O型|ABO)",
        "(输血|血型).{0,10}(必须配型|要先配型|配型|同型输注|交叉配血)"
      ],
      "consensus": "属实（临床医学共识）",
      "level": "true",
      "explain": "ABO 血型系统根据红细胞表面是否存在 A、B 抗原分为 A 型、B 型、AB 型与 O 型四种，由奥地利学者兰德施泰纳于 1900 年发现。临床输血前必须完成 ABO 与 RhD 血型鉴定及交叉配血试验，异型输血可引发致命的溶血反应。此外还有 Rh、MNSSU 等三十余个已被国际输血协会确认的血型系统。",
      "caveat": "O 型并非真正的「万能供血者」，仅在极端紧急且无同型血时才有限替代。",
      "sources": [
        {"title": "临床输血技术规范 - 国家卫生健康委员会", "url": "http://www.nhc.gov.cn/", "domain": "nhc.gov.cn", "published_at": "2021-08-09", "credibility": "A", "credibility_score": 96, "source_type": "knowledge", "org_type": "政府机构", "snippet": "临床输血前必须进行ABO与RhD血型鉴定和交叉配血试验，无误后方可输注。"},
        {"title": "ABO血型系统 - 中国科普博览", "url": "https://www.kepu.net.cn/", "domain": "kepu.net.cn", "published_at": "2023-02-14", "credibility": "A", "credibility_score": 90, "source_type": "knowledge", "org_type": "科研院所", "snippet": "ABO血型系统按红细胞表面抗原分为A、B、AB、O四型，输血前配型不符可引起严重溶血反应。"}
      ]
    },
    {
      "id": "D201",
      "domain": "animal",
      "name": "蝙蝠是唯一真正会飞的哺乳动物",
      "patterns": [
        "蝙蝠.{0,12}(唯一|唯一能|唯一会).{0,6}(会飞的|能飞的|能真正飞行的).{0,4}哺乳动物",
        "唯一.{0,2}(会飞|能够飞行).{0,4}哺乳动物.{0,10}蝙蝠",
        "蝙蝠.{0,8}(不是鸟|属于哺乳|哺乳动物)"
      ],
      "consensus": "属实（动物学共识）",
      "level": "true",
      "explain": "蝙蝠（翼手目）是哺乳动物中唯一演化出真正扑翼飞行能力的类群，其前肢特化为由极度延长的指骨支撑的翼膜。哺乳动物中存在其他「滑翔」类群（如鼯鼠、袋貂、飞狐猴），但它们只能借皮膜滑翔，不能主动产生升力持续飞行，因此不属于真正的飞行。翼手目是哺乳动物中第二大目，物种数仅次于啮齿目。",
      "caveat": "滑翔不等于飞行，二者在空气动力学上有本质区别。",
      "sources": [
        {"title": "翼手目（蝙蝠）研究 - 中国科学院动物研究所", "url": "http://www.ioz.cas.cn/", "domain": "ioz.cas.cn", "published_at": "2023-07-25", "credibility": "A", "credibility_score": 94, "source_type": "knowledge", "org_type": "科研院所", "snippet": "翼手目是哺乳动物中唯一具备真正主动飞行能力的类群，前肢特化为翼膜，物种数量居哺乳动物第二。"},
        {"title": "蝙蝠为什么能飞 - 中国科普博览", "url": "https://www.kepu.net.cn/", "domain": "kepu.net.cn", "published_at": "2022-06-30", "credibility": "A", "credibility_score": 90, "source_type": "knowledge", "org_type": "科研院所", "snippet": "鼯鼠等只能滑翔，不能像蝙蝠一样通过扑翼产生持续升力。"}
      ]
    },
    {
      "id": "D202",
      "domain": "animal",
      "name": "鸵鸟遇险会把头埋进沙子",
      "patterns": [
        "鸵鸟.{0,12}(把头|将头|埋头|钻进沙子|埋进沙子|藏进沙子|头埋进)",
        "(遇到危险|逃跑时|害怕时).{0,8}鸵鸟.{0,8}(埋|藏|把头)",
        "鸵鸟.{0,8}(逃避|躲避).{0,6}(把头|埋头)"
      ],
      "consensus": "不实（常见动物误区）",
      "level": "false",
      "explain": "鸵鸟在遇到威胁时的首选策略是依靠成年个体可达 70 km/h 的奔跑速度逃脱，或卧伏把脖子平贴地面以降低轮廓（从远处看像是「头埋起来」）。它们还需频繁低头用喙翻动巢穴中的蛋，这也是误解的来源之一。这种行为如果被当真，鸵鸟会因窒息而无法存活。",
      "caveat": "「把头埋进沙子逃避现实」是比喻用法，非事实描述。",
      "sources": [
        {"title": "鸵鸟的行为习性 - 中国科学院动物研究所", "url": "http://www.ioz.cas.cn/", "domain": "ioz.cas.cn", "published_at": "2022-10-11", "credibility": "A", "credibility_score": 93, "source_type": "knowledge", "org_type": "科研院所", "snippet": "鸵鸟遇险以高速奔跑逃离为主，必要时卧地伸颈隐藏，并不具备埋头入沙的行为习性。"},
        {"title": "鸵鸟真的会埋头吗 - 科普中国", "url": "https://www.kepuchina.cn/", "domain": "kepuchina.cn", "published_at": "2023-04-02", "credibility": "A", "credibility_score": 88, "source_type": "knowledge", "org_type": "科普平台", "snippet": "该说法源于远观时的视觉误差以及鸵鸟低头翻蛋、孵卵的行为，属于以讹传讹。"}
      ]
    },
    {
      "id": "D203",
      "domain": "animal",
      "name": "鲨鱼一生不断更换牙齿",
      "patterns": [
        "鲨鱼.{0,10}(不断|一直|终生|一生|一辈子).{0,6}(换牙|更换牙齿|长出新牙|掉牙)",
        "鲨鱼.{0,8}(好几排|数排|一排排).{0,4}(牙齿|牙)"
      ],
      "consensus": "属实（动物学共识）",
      "level": "true",
      "explain": "鲨鱼的牙齿并非固定在同一牙槽中，而是着生于颌部软组织上的「传送带」式多排结构，前排牙齿脱落或磨损后，后排牙齿会向前推移补位。部分鲨鱼一生可更换数万颗牙齿，多数种类约每 1—2 周更换一颗。与此同时，多数鲨鱼的骨骼为软骨，在自然环境中较难保存为化石。",
      "caveat": "不同种类的换牙周期差异较大，从数天到数月不等。",
      "sources": [
        {"title": "软骨鱼类牙齿更替研究 - 中国科学院动物研究所", "url": "http://www.ioz.cas.cn/", "domain": "ioz.cas.cn", "published_at": "2023-09-08", "credibility": "A", "credibility_score": 93, "source_type": "knowledge", "org_type": "科研院所", "snippet": "鲨鱼牙齿呈多排传送带状排列，终生持续替换，前排脱落后由后排前移补位。"},
        {"title": "鲨鱼有多少颗牙 - 中国科普博览", "url": "https://www.kepu.net.cn/", "domain": "kepu.net.cn", "published_at": "2022-05-19", "credibility": "A", "credibility_score": 89, "source_type": "knowledge", "org_type": "科研院所", "snippet": "鲨鱼一生可替换牙齿上万颗，多数种类每1—2周更换一颗。"}
      ]
    },
    {
      "id": "D204",
      "domain": "animal",
      "name": "章鱼有三颗心脏",
      "patterns": [
        "章鱼.{0,10}(三个|三颗|3个|3颗)心脏",
        "(章鱼|八爪鱼|乌贼|鱿鱼).{0,8}(心脏).{0,6}(几个|多少|三)",
        "章鱼.{0,8}(蓝色的血|血液是蓝色)"
      ],
      "consensus": "属实（动物学共识）",
      "level": "true",
      "explain": "头足类动物（章鱼、乌贼、鱿鱼）具有两颗鳃心与一颗体心：两颗鳃心分别把血液泵入左右鳃进行气体交换，再由单颗体心将含氧血输送至全身。其血液依靠含铜的血蓝蛋白携氧，因而呈淡蓝色，而非脊椎动物的铁基血红蛋白红色。章鱼在快速游动时体心会短暂停跳，这也是它容易疲劳的原因之一。",
      "caveat": "乌贼、鱿鱼同属头足类，循环结构相似。",
      "sources": [
        {"title": "头足类循环系统研究 - 中国科学院海洋研究所", "url": "http://www.qdio.cas.cn/", "domain": "qdio.cas.cn", "published_at": "2023-05-26", "credibility": "A", "credibility_score": 93, "source_type": "knowledge", "org_type": "科研院所", "snippet": "头足类具有两枚鳃心与一枚体心，血液含血蓝蛋白，呈淡蓝色。"},
        {"title": "章鱼的三颗心脏 - 中国科普博览", "url": "https://www.kepu.net.cn/", "domain": "kepu.net.cn", "published_at": "2022-08-21", "credibility": "A", "credibility_score": 89, "source_type": "knowledge", "org_type": "科研院所", "snippet": "两颗鳃心负责泵血入鳃，一颗体心负责供全身，游泳时体心会短暂停跳。"}
      ]
    },
    {
      "id": "D205",
      "domain": "animal",
      "name": "大熊猫在分类上属于食肉目",
      "patterns": [
        "(大熊猫|熊猫).{0,10}(属于|归于|划分为|其实是).{0,6}(食肉目|肉食目|食肉动物|肉食动物)",
        "(大熊猫|熊猫).{0,12}(虽然吃竹子|吃素|素食).{0,10}(食肉|肉食|伪装者)"
      ],
      "consensus": "属实（分类学共识）",
      "level": "true",
      "explain": "大熊猫在动物分类上属于哺乳纲食肉目熊科大熊猫属。其消化系统基本保留食肉动物的构造——简单的单室胃、较短的肠道、缺乏分解纤维素所必需的多室胃与发达盲肠，因此只能消化竹子中的一小部分营养，必须大量进食（日食竹 10—16 公斤）并维持低代谢水平。基因组研究也证实它仍处于食肉目熊科的系统位置上。",
      "caveat": "「食素的食肉动物」指其食性与分类归属的分裂，不代表它能从竹子中高效获取能量。",
      "sources": [
        {"title": "大熊猫分类地位与食性适应 - 中国科学院动物研究所", "url": "http://www.ioz.cas.cn/", "domain": "ioz.cas.cn", "published_at": "2023-10-16", "credibility": "A", "credibility_score": 94, "source_type": "knowledge", "org_type": "科研院所", "snippet": "大熊猫隶属食肉目熊科，消化系统保留食肉动物特征，依赖大量进食竹子维持能量。"},
        {"title": "大熊猫为什么吃竹子 - 国家林业和草原局", "url": "https://www.forestry.gov.cn/", "domain": "forestry.gov.cn", "published_at": "2022-03-30", "credibility": "A", "credibility_score": 93, "source_type": "knowledge", "org_type": "政府机构", "snippet": "大熊猫99%的食物为竹子，但分类地位与消化道结构均属食肉目，消化纤维能力有限。"}
      ]
    },
    {
      "id": "D206",
      "domain": "animal",
      "name": "动物行为能预报地震",
      "patterns": [
        "(动物|蛤蟆|蟾蜍|蛇|狗|猫|老鼠|鱼|蚂蚁|虫子).{0,12}(预报|预测|预知|预警).{0,6}地震",
        "地震.{0,6}(前兆|来临前).{0,8}(动物|蛤蟆|蟾蜍|蛇出洞|老鼠搬家|鱼跃).{0,10}(能|可以|靠得住)",
        "(看动物|动物异常).{0,8}(判断|推测|知道).{0,6}(地震|马上地震)"
      ],
      "consensus": "存疑（缺乏科学实证）",
      "level": "uncertain",
      "explain": "动物异常行为能否用于地震短临预测，目前缺少可检验、可重复的科学证据。历史上确有关于震前动物异常的记录，但同样多的动物异常现象并未对应任何地震，两者之间难以建立稳定的统计关系。我国《防震减灾法》明确地震预报意见由国务院或省级人民政府统一发布，任何单位与个人不得向社会散布地震预报意见。目前主要地震国家均依赖地震台网监测，而非动物观测。",
      "caveat": "不能排除某些机械振动、地下水与气体前兆被敏感物种感知的可能，但这尚未形成可用于预报的指标体系。",
      "sources": [
        {"title": "地震预报的现状与方法 - 中国地震局", "url": "https://www.cea.gov.cn/", "domain": "cea.gov.cn", "published_at": "2023-04-11", "credibility": "A", "credibility_score": 95, "source_type": "knowledge", "org_type": "政府机构", "snippet": "地震预报是世界性科学难题，目前主要依靠地震台网监测与地球物理观测，尚无成熟的短临预测方法。"},
        {"title": "动物预报地震靠谱吗 - 中国互联网联合辟谣平台", "url": "https://www.piyao.org.cn/", "domain": "piyao.org.cn", "published_at": "2023-08-06", "credibility": "A", "credibility_score": 92, "source_type": "knowledge", "org_type": "辟谣平台", "snippet": "震例中的动物异常多为回顾性归纳，缺乏统计显著性，不能作为地震预报依据。"}
      ]
    },
    {
      "id": "D207",
      "domain": "animal",
      "name": "蜜蜂蜇人后自己会死去",
      "patterns": [
        "(蜜蜂|工蜂).{0,10}(蜇|螫|刺).{0,8}(人|之后|后|完).{0,10}(死|死去|死亡|活不了)",
        "(蜜蜂|工蜂).{0,8}(一生|一次).{0,6}(只能蜇|蜇一次).{0,8}(死|丧命)",
        "为什么.{0,4}蜜蜂.{0,6}蜇.{0,4}(完|后).{0,6}就死"
      ],
      "consensus": "属实（昆虫学共识）",
      "level": "true",
      "explain": "西方蜜蜂的螫针带有倒钩，刺入人类等具有厚实弹性皮肤的动物后无法拔出，蜜蜂飞离时会将螫针连同毒囊、部分内脏一同撕脱，随后死亡。蜂后（蜂王）的螫针无倒钩，可重复蜇刺；常见的马蜂、黄蜂螫针也较光滑，可多次攻击。因此「蜜蜂蜇人后死」只适用于工蜂刺哺乳动物的情形。",
      "caveat": "胡蜂、马蜂可反复蜇刺，不要用蜜蜂的规律套用到所有蜂类。",
      "sources": [
        {"title": "蜜蜂螫针结构与防御行为 - 中国农业科学院蜜蜂研究所", "url": "https://www.caas.cn/", "domain": "caas.cn", "published_at": "2023-06-05", "credibility": "A", "credibility_score": 93, "source_type": "knowledge", "org_type": "科研院所", "snippet": "工蜂螫针有倒钩，蜇刺后螫针连同毒囊与内脏被拉出，蜜蜂随即死亡；蜂王螫针无倒钩，可多次蜇刺。"},
        {"title": "蜜蜂与马蜂的区别 - 中国科普博览", "url": "https://www.kepu.net.cn/", "domain": "kepu.net.cn", "published_at": "2022-07-14", "credibility": "A", "credibility_score": 89, "source_type": "knowledge", "org_type": "科研院所", "snippet": "马蜂等螫针较光滑，蜇刺后可存活并再次攻击，切勿混淆。"}
      ]
    },
    {
      "id": "D301",
      "domain": "human_animal",
      "name": "养猫必然会感染弓形虫",
      "patterns": [
        "(养猫|猫).{0,12}(一定|必然|肯定|都会|就会).{0,6}(感染|得|传播|传染).{0,4}弓形虫",
        "(孕妇|怀孕).{0,10}(绝对不能|不能|不能养).{0,4}猫.{0,10}(弓形虫|畸形)",
        "家里.{0,2}有猫.{0,10}(一定|必然).{0,6}弓形虫"
      ],
      "consensus": "不实（医学共识）",
      "level": "false",
      "explain": "弓形虫感染猫科动物是其唯一终宿主，猫通过粪便排出卵囊，但需在外界环境中放置 1—5 天才形成感染力。家养猫只（不外出捕食、只吃猫粮或熟食）感染率显著低于散养猫。人感染弓形虫的主要途径是食用未熟透的肉类、被污染的蔬菜或不洁饮水，而非抚摸家猫。备孕期女性可通过避免清理猫砂、戴手套操作、肉类彻底加热等措施有效预防。",
      "caveat": "孕妇初次感染确实存在垂直传播风险，采取预防措施即可，不必因此弃养。",
      "sources": [
        {"title": "弓形虫病防治知识问答 - 中国疾病预防控制中心", "url": "https://www.chinacdc.cn/", "domain": "chinacdc.cn", "published_at": "2023-02-20", "credibility": "A", "credibility_score": 96, "source_type": "knowledge", "org_type": "疾控机构", "snippet": "猫是弓形虫终宿主，卵囊需在外界孢子化1—5天才具感染性；人主要通过食用未熟肉类与被污染食物感染。"},
        {"title": "备孕期能不能养猫 - 中华医学会妇产科学分会", "url": "https://www.cma.org.cn/", "domain": "cma.org.cn", "published_at": "2022-09-09", "credibility": "A", "credibility_score": 91, "source_type": "knowledge", "org_type": "学术团体", "snippet": "规范饲养与做好个人卫生即可有效预防，不建议在孕期盲目弃养宠物。"}
      ]
    },
    {
      "id": "D302",
      "domain": "human_animal",
      "name": "只有狗会传播狂犬病",
      "patterns": [
        "(只有|仅|仅有|光是).{0,3}(狗|犬类).{0,10}(才?会|能).{0,4}(传播|传染).{0,4}狂犬病",
        "(猫|狗以外|除狗).{0,10}(不会|不能|不会传播|不传播).{0,4}狂犬病"
      ],
      "consensus": "不实（疾控共识）",
      "level": "false",
      "explain": "狂犬病病毒可感染所有哺乳动物，猫同样属于常见的传播宿主。在我国报告的人间狂犬病病例中，犬是最主要传染源，其次为猫；此外还可由蝙蝠、狐狸、獾、狼等野生动物传播。因此被猫抓咬伤后同样需要按狂犬病暴露分级进行规范处置，包括伤口冲洗、疫苗接种，必要时注射被动免疫制剂。",
      "caveat": "猫传播占比的地区差异较大，但「猫不会传播」的说法在任何权威文件中均无依据。",
      "sources": [
        {"title": "狂犬病暴露预防处置工作规范 - 国家卫生健康委员会", "url": "http://www.nhc.gov.cn/", "domain": "nhc.gov.cn", "published_at": "2023-09-12", "credibility": "A", "credibility_score": 96, "source_type": "knowledge", "org_type": "政府机构", "snippet": "规范的暴露处置适用于所有可能的狂犬病病毒宿主，包括犬、猫及多种野生动物。"},
        {"title": "狂犬病防治知识要点 - 中国疾病预防控制中心", "url": "https://www.chinacdc.cn/", "domain": "chinacdc.cn", "published_at": "2023-09-28", "credibility": "A", "credibility_score": 95, "source_type": "knowledge", "org_type": "疾控机构", "snippet": "犬是我国人间狂犬病主要传染源，猫次之，须按Ⅱ级、Ⅲ级暴露分级处置。"}
      ]
    },
    {
      "id": "D303",
      "domain": "human_animal",
      "name": "被猫狗抓咬没出血就不用处理",
      "patterns": [
        "(被猫|被狗|猫咬|狗咬|猫抓|狗抓|让猫|让狗).{0,12}(没出血|没有出血|没破皮|没流血|不严重|一点点).{0,12}(不用|不必|不需要|没关系|没事|不用打)",
        "(轻微|小小|一点点).{0,2}(抓伤|咬伤).{0,10}(不用|不必|不需要).{0,6}(打疫苗|处理|管它)",
        "(没见血|不见血|没有伤口).{0,6}就?不用.{0,4}(打针|接种|打疫苗)"
      ],
      "consensus": "不实（处置规范否定）",
      "level": "false",
      "explain": "国家现行处置规范把狂犬病暴露分为三级：Ⅰ级（接触/喂养、完好皮肤被舔）只需清洗；Ⅱ级（无出血的咬伤抓伤、皮肤被轻咬）属肉眼可见的轻微破损，须立即处理伤口并接种狂犬病疫苗；Ⅲ级（贯穿性皮肤咬伤抓伤、破损皮肤被舔、黏膜被污染、暴露于蝙蝠）还须注射被动免疫制剂。是否出血不是判断标准，肉眼看不到的细微破皮同样可能构成感染途径。",
      "caveat": "可用酒精擦拭初步判断是否有皮肤破损：有刺痛感即为Ⅱ级及以上。",
      "sources": [
        {"title": "狂犬病暴露预防处置工作规范 - 国家卫生健康委员会", "url": "http://www.nhc.gov.cn/", "domain": "nhc.gov.cn", "published_at": "2023-09-12", "credibility": "A", "credibility_score": 96, "source_type": "knowledge", "org_type": "政府机构", "snippet": "Ⅱ级暴露为无明显出血的咬伤抓伤，须立即冲洗消毒伤口并接种疫苗；Ⅲ级暴露还需注射被动免疫制剂。"},
        {"title": "被抓了一道要不要打针 - 中国互联网联合辟谣平台", "url": "https://www.piyao.org.cn/", "domain": "piyao.org.cn", "published_at": "2023-10-20", "credibility": "A", "credibility_score": 92, "source_type": "knowledge", "org_type": "辟谣平台", "snippet": "专家提醒：能否出血不是判断依据，皮肤肉眼不可见的破损同样需要按规范接种。"}
      ]
    },
    {
      "id": "D304",
      "domain": "human_animal",
      "name": "禽流感病毒不会感染人类",
      "patterns": [
        "(禽流感|H5N1|H5N6|H7N9|H9N2).{0,12}(不会|不能|不).{0,4}(传给人|传染人|传给人类|感染人类|感染人)",
        "(吃禽肉|吃鸡肉|吃鸡蛋|吃鸡苗).{0,10}(就一定|百分百|绝对)安全",
        "禽流感.{0,8}(只在禽类|只在鸟类).{0,6}(之间|传播)"
      ],
      "consensus": "不实（疾控共识）",
      "level": "false",
      "explain": "部分甲型流感病毒亚型具备跨物种传播能力并已在人群中造成散发病例，包括 H5N1、H5N6、H7N9、H9N2 等禽源亚型。我国报告的 H7N9 病例多与活禽市场暴露相关，重症与病死率较高。防控建议包括：避免接触活禽与病死禽、购买检疫合格的冷鲜禽产品、禽肉与蛋类彻底加熱、处理生禽后勤洗手。禽流感病毒不耐热，煮熟即可灭活。",
      "caveat": "目前多数亚型尚不具备持续人传人能力，但这不等于「不会感染人类」。",
      "sources": [
        {"title": "人感染禽流感防控知识 - 中国疾病预防控制中心", "url": "https://www.chinacdc.cn/", "domain": "chinacdc.cn", "published_at": "2023-11-30", "credibility": "A", "credibility_score": 96, "source_type": "knowledge", "org_type": "疾控机构", "snippet": "H5N6、H7N9、H9N2等禽流感病毒亚型已报告人感染病例，主要因接触活禽或其污染环境而感染。"},
        {"title": "人感染H7N9禽流感 - 国家卫生健康委员会", "url": "http://www.nhc.gov.cn/", "domain": "nhc.gov.cn", "published_at": "2022-02-15", "credibility": "A", "credibility_score": 95, "source_type": "knowledge", "org_type": "政府机构", "snippet": "多数病例有活禽暴露史，建议避免接触活禽、彻底加热禽类产品、注意手卫生。"}
      ]
    },
    {
      "id": "D305",
      "domain": "human_animal",
      "name": "狂犬病一旦发病几乎100%死亡",
      "patterns": [
        "狂犬病.{0,12}(一旦发病|发病后|发病).{0,12}(100%|百分之百|几乎百分百|必死|无法治愈|几乎必死)",
        "狂犬病.{0,10}(死亡率|致死率).{0,8}(100%|接近100%|极高|百分之百)",
        "得了狂犬病.{0,8}(能治好吗|有救吗|能活吗)"
      ],
      "consensus": "基本属实（医学共识）",
      "level": "mostly_true",
      "explain": "狂犬病病毒侵入中枢神经系统后出现临床症状者，病死率接近 100%，迄今全球仅有极少数经密尔沃基疗法等特殊手段存活的报告病例，且多留有严重后遗症，因此该病在公共卫生上按「发病即不治」对待。关键在于暴露后的及时规范处置——彻底冲洗伤口 15 分钟以上、按规定接种疫苗与被动免疫制剂，可将发病风险降到接近于零。",
      "caveat": "极个别存活病例多为蝙蝠相关毒株且事先未全程接种，不能据此认为发病可治。",
      "sources": [
        {"title": "狂犬病知识答疑 - 世界卫生组织", "url": "https://www.who.int/health-topics/rabies", "domain": "who.int", "published_at": "2023-09-28", "credibility": "A", "credibility_score": 97, "source_type": "knowledge", "org_type": "国际组织", "snippet": "WHO指出，狂犬病一旦出现临床症状几乎必然致死，但暴露后及时处置可有效预防发病。"},
        {"title": "狂犬病防治宣传核心知识 - 中国疾病预防控制中心", "url": "https://www.chinacdc.cn/", "domain": "chinacdc.cn", "published_at": "2023-09-28", "credibility": "A", "credibility_score": 95, "source_type": "knowledge", "org_type": "疾控机构", "snippet": "狂犬病病死率接近100%，规范的伤口处理与疫苗接种是唯一有效手段。"}
      ]
    },
    {
      "id": "D306",
      "domain": "human_animal",
      "name": "蝙蝠是多种新发病毒的天然宿主",
      "patterns": [
        "蝙蝠.{0,12}(多种|许多|很多|大量).{0,4}(新发)?病毒.{0,8}(宿主|自然宿主|天然宿主|源头|携带者)",
        "蝙蝠.{0,10}(传播|携带|宿主).{0,10}(冠状病毒|狂犬病毒|亨德拉|尼帕|埃博拉|马尔堡)",
        "(新发传染病|人畜共患病).{0,10}(蝙蝠|蝙蝠宿主)"
      ],
      "consensus": "属实（病毒学研究共识）",
      "level": "true",
      "explain": "蝙蝠是翼手目动物，已被证实是多种可跨物种传播病毒的自然宿主，包括冠状病毒、狂犬病毒属（含丽沙病毒）、尼帕病毒、亨德拉病毒，以及与丝状病毒相关的马尔堡病毒。原因包括：蝙蝠寿命长、群居密度大、具飞行能力因而分布广，且其免疫系统对病毒的炎性反应受到抑制，使其能长期带毒而不发病。是否由蝙蝠直接传给人，通常还需中间宿主参与。",
      "caveat": "「蝙蝠是宿主」不等于「吃蝙蝠」或「身边蝙蝠都有毒」，我国分布的蝙蝠以食虫和食果为主，无需恐慌。",
      "sources": [
        {"title": "蝙蝠携带病毒与跨种传播研究 - 中国科学院动物研究所", "url": "http://www.ioz.cas.cn/", "domain": "ioz.cas.cn", "published_at": "2023-05-18", "credibility": "A", "credibility_score": 94, "source_type": "knowledge", "org_type": "科研院所", "snippet": "研究证实蝙蝠为多种冠状病毒与丽沙病毒的自然宿主，其免疫调节特征使其可长期带毒。"},
        {"title": "人畜共患病的动物宿主 - 中国疾病预防控制中心", "url": "https://www.chinacdc.cn/", "domain": "chinacdc.cn", "published_at": "2022-12-08", "credibility": "A", "credibility_score": 95, "source_type": "knowledge", "org_type": "疾控机构", "snippet": "多种新发传染病与野生动物携带病原体相关，避免捕猎、食用与密切接触野生动物是关键预防措施。"}
      ]
    },
    {
      "id": "D401",
      "domain": "life",
      "name": "反复烧开的水会致癌",
      "patterns": [
        "(千滚水|反复烧开|反复煮沸|多次煮沸|煮了又煮).{0,12}(致癌|有毒|亚硝酸盐超标|不能喝|有害|不能吃)",
        "(隔夜的白开水|隔夜水).{0,10}(亚硝酸盐|致癌)",
        "(饮水机|电水壶).{0,8}(反复加热).{0,10}(致癌|有毒)"
      ],
      "consensus": "不实（多次权威检测否定）",
      "level": "false",
      "explain": "多次送检结果显示，自来水反复煮沸后亚硝酸盐含量虽略有上升，但升高幅度极小，远低于《生活饮用水卫生标准》GB 5749 规定的 1 mg/L 限值，正常饮用不构成致癌风险。饮水的安全风险主要来自容器不洁与长期存放导致微生物滋生，而非「反复烧开」本身。亚硝酸盐本身也非直接致癌物，其在胃酸条件下形成的亚硝胺才是关注对象。",
      "caveat": "建议现烧现喝、保持水具清洁，别让水在水箱里长期反复加热存放。",
      "sources": [
        {"title": "反复加热饮用水亚硝酸盐检测 - 国家食品安全风险评估中心", "url": "https://www.cfsa.net.cn/", "domain": "cfsa.net.cn", "published_at": "2022-06-14", "credibility": "A", "credibility_score": 95, "source_type": "knowledge", "org_type": "风险评估机构", "snippet": "实验显示反复煮沸水中亚硝酸盐增幅有限，远低于国家标准限值，不构成健康风险。"},
        {"title": "千滚水致癌是谣言 - 中国互联网联合辟谣平台", "url": "https://www.piyao.org.cn/", "domain": "piyao.org.cn", "published_at": "2023-03-09", "credibility": "A", "credibility_score": 92, "source_type": "knowledge", "org_type": "辟谣平台", "snippet": "多次检测证实千滚水亚硝酸盐远低于限值，网传致癌说法缺乏依据。"}
      ]
    },
    {
      "id": "D402",
      "domain": "life",
      "name": "食物相克会中毒甚至致死",
      "patterns": [
        "(食物相克|食物相尅|相克).{0,12}(中毒|致死|致命|不能一起吃|吃了会死|等于吃砒霜)",
        "(螃蟹与柿子|柿子和螃蟹|豆浆和鸡蛋|菠菜和豆腐|虾和维C|虾和柠檬).{0,12}(中毒|相克|不能同吃|致死)",
        "两种食物.{0,8}(一起吃|同食).{0,10}(有毒|致死|中毒)"
      ],
      "consensus": "不实（营养学界明确否定）",
      "level": "false",
      "explain": "「食物相克」缺乏科学证据。中国营养学会与中国科协曾联合组织人群试食试验，对流传较广的所谓相克组合进行验证，受试者均未出现异常反应。人们吃完某种组合后不适，多半源于食物本身不洁、未煮熟、过敏体质、乳糖不耐受或一次性进食过量，而非两种食物「相克」。营养学强调食物多样化与合理搭配，不存在一张需要背的相克表。",
      "caveat": "确有真实禁忌的是药物与食物相互作用（如头孢类与酒精、华法林与大量绿叶菜），与民间「食物相克」不同。",
      "sources": [
        {"title": "食物相克的科学真相 - 中国营养学会", "url": "https://www.cnsoc.org/", "domain": "cnsoc.org", "published_at": "2022-11-25", "credibility": "A", "credibility_score": 94, "source_type": "knowledge", "org_type": "学术团体", "snippet": "学会通过人群试食试验验证多种流传组合，未观察到任何异常反应，食物相克之说无科学依据。"},
        {"title": "食物相克是假的 - 中国互联网联合辟谣平台", "url": "https://www.piyao.org.cn/", "domain": "piyao.org.cn", "published_at": "2023-01-12", "credibility": "A", "credibility_score": 92, "source_type": "knowledge", "org_type": "辟谣平台", "snippet": "同食不适多因食物不洁、未煮熟、过敏或进食过量导致，与食物组合本身无关。"}
      ]
    },
    {
      "id": "D403",
      "domain": "life",
      "name": "喝骨头汤能有效补钙",
      "patterns": [
        "(骨头汤|排骨汤|大骨汤|筒骨汤|猪骨汤).{0,12}(补钙|含钙高|富含钙|钙含量丰富|能补.的钙)",
        "喝.{0,4}(骨头汤|排骨汤|大骨汤).{0,8}(可以|能|为了).{0,4}补钙",
        "(骨折|补钙).{0,10}(多喝|喝).{0,4}骨头汤"
      ],
      "consensus": "不实（营养学共识）",
      "level": "false",
      "explain": "动物骨骼中的钙以羟基磷酸钙形式存在，难溶于水，长时间炖煮也难以大量溶出。检测数据显示，骨头汤的钙含量通常在每百毫升 2—10 毫克左右，而同等体积牛奶的钙含量约为 100—120 毫克，两者相差十倍以上，且骨头汤中溶解较多的是脂肪、嘌呤与少量氨基酸。补钙优先选择奶类、豆制品、深绿色蔬菜与小鱼小虾等。",
      "caveat": "骨头汤高嘌呤，痛风与高尿酸人群不宜多喝；加醋炖煮可略微提高钙溶出，但提升有限。",
      "sources": [
        {"title": "中国居民膳食营养素参考摄入量解读 - 中国营养学会", "url": "https://www.cnsoc.org/", "domain": "cnsoc.org", "published_at": "2023-04-26", "credibility": "A", "credibility_score": 94, "source_type": "knowledge", "org_type": "学术团体", "snippet": "补钙应以奶类及其制品、豆制品与深绿色蔬菜为主，骨汤含钙量极低，不宜作为补钙来源。"},
        {"title": "骨头汤补钙不靠谱 - 科普中国", "url": "https://www.kepuchina.cn/", "domain": "kepuchina.cn", "published_at": "2022-10-22", "credibility": "A", "credibility_score": 89, "source_type": "knowledge", "org_type": "科普平台", "snippet": "骨汤钙含量仅为牛奶的十分之一左右，且脂肪与嘌呤含量较高。"}
      ]
    },
    {
      "id": "D404",
      "domain": "life",
      "name": "吃黑芝麻能让白发转黑",
      "patterns": [
        "(黑芝麻|芝麻|黑豆|黑米|何首乌|桑葚).{0,12}(让|使|令|把).{0,4}(白发|白头发|白头)?.{0,6}(变黑|转黑|黑回来|重新变黑)",
        "(白发|少白头).{0,10}(吃黑芝麻|多吃黑色食物|以黑补黑).{0,8}(能|可以|有用)",
        "以形补形.{0,10}(黑芝麻|黑色食物).{0,8}(白发)"
      ],
      "consensus": "不实（缺乏证据）",
      "level": "false",
      "explain": "头发变白源于毛囊黑素细胞功能衰退或数量减少，与遗传、年龄、精神压力、某些营养缺乏（如维生素 B12、铁、铜）及自身免疫等因素相关。黑色食物的颜色多来自植物色素（花青素、黑色素类物），经消化后并不定向补充毛囊黑素。已长出的白发无法因吃某种食物而重新变黑，因为毛发的色素沉着发生在毛球生成阶段。",
      "caveat": "由营养缺乏导致的少数可逆性白发在纠正缺乏后可能改善，这与「黑色食物」无关。",
      "sources": [
        {"title": "毛发变白的机制 - 中华医学会皮肤性病学分会", "url": "https://www.cma.org.cn/", "domain": "cma.org.cn", "published_at": "2022-08-19", "credibility": "A", "credibility_score": 92, "source_type": "knowledge", "org_type": "学术团体", "snippet": "白发源于毛囊黑素细胞减少或功能障碍，与遗传和衰老关系最密切，食物色素无法定向补充。"},
        {"title": "以形补形、以色补色靠谱吗 - 中国互联网联合辟谣平台", "url": "https://www.piyao.org.cn/", "domain": "piyao.org.cn", "published_at": "2023-06-18", "credibility": "A", "credibility_score": 92, "source_type": "knowledge", "org_type": "辟谣平台", "snippet": "植物色素经消化分解为小分子，不会按颜色作用于特定器官，所谓以色补色不成立。"}
      ]
    },
    {
      "id": "D405",
      "domain": "life",
      "name": "流鼻血时要仰头止血",
      "patterns": [
        "(流鼻血|鼻子出血|鼻出血|鼻子流血).{0,12}(要|应该|得|需|应当|不).{0,6}(仰着?头|抬着?头|往后仰|仰起头来?|举高手)",
        "(仰着?头|抬着?头|往后面仰).{0,8}(能|可以|才能|为了|就).{0,4}(止血|止鼻血|断鼻血|止住)",
        "流鼻血.{0,10}(怎么办|怎么处理|不止血).{0,10}(仰|抬)"
      ],
      "consensus": "不实（急诊医学否定）",
      "level": "false",
      "explain": "仰头会使血液流向鼻咽部被吞咽，不但没有止血作用，还可能引起恶心呕吐，甚至导致血液误吸入气道。正确做法是：身体前倾、头部略向前下方，用拇指与食指捏住鼻翼两侧的柔软部位持续压迫 10—15 分钟，同时用嘴呼吸，可在鼻梁与额部冷敷辅助收缩血管。若 20 分钟仍未止住、出血量大或反复发作，应及时就医。",
      "caveat": "同时不可用纸巾、棉花胡乱填塞，也不宜反复松手查看。",
      "sources": [
        {"title": "鼻出血急救处理 - 中华医学会耳鼻咽喉头颈外科学分会", "url": "https://www.cma.org.cn/", "domain": "cma.org.cn", "published_at": "2022-05-11", "credibility": "A", "credibility_score": 92, "source_type": "knowledge", "org_type": "学术团体", "snippet": "推荐坐位前倾、捏压鼻翼10—15分钟，并配合冷敷；仰头与举手均无止血作用。"},
        {"title": "鼻出血的正确处理 - 科普中国", "url": "https://www.kepuchina.cn/", "domain": "kepuchina.cn", "published_at": "2023-02-27", "credibility": "A", "credibility_score": 89, "source_type": "knowledge", "org_type": "科普平台", "snippet": "仰头会使血流入咽部被吞下或呛入气道，属常见错误处理，应改为低头前倾按捏鼻翼。"}
      ]
    },
    {
      "id": "D406",
      "domain": "life",
      "name": "发芽的土豆含有毒素",
      "patterns": [
        "(发芽|长芽|发绿|变青|发青).{0,4}(土豆|马铃薯|洋芋).{0,12}(有毒|含毒|龙葵素|龙葵碱|不能吃|不能食用)",
        "(土豆|马铃薯).{0,8}(龙葵素|龙葵碱|茄碱).{0,8}(含量|升高|增加)",
        "(土豆|马铃薯).{0,4}发芽.{0,8}(还能吃吗|吃了会)"
      ],
      "consensus": "属实（食品安全共识）",
      "level": "true",
      "explain": "马铃薯发芽或见光变绿后，块茎中的糖苷生物碱（主要为龙葵素，即 α-茄碱与 α-卡茄碱）含量显著升高，正常马铃薯含量一般低于每公斤 100 毫克，而发芽部位与芽眼周围可升高至数百甚至上千毫克。该物质对热稳定，普通烹煮难以完全破坏，食用后可能引起口腔灼烧感、恶心呕吐、腹痛腹泻，严重时会出现神经系统症状。建议把发芽、青紫部分及周围组织彻底削除，严重发芽的直接丢弃；储存宜避光阴凉。",
      "caveat": "轻度发芽且彻底削去芽与青皮、浸泡并充分加热可降低风险，孕妇与儿童建议一律弃用。",
      "sources": [
        {"title": "马铃薯及其制品中龙葵素的风险提示 - 国家食品安全风险评估中心", "url": "https://www.cfsa.net.cn/", "domain": "cfsa.net.cn", "published_at": "2022-04-19", "credibility": "A", "credibility_score": 95, "source_type": "knowledge", "org_type": "风险评估机构", "snippet": "发芽或变绿马铃薯龙葵素含量明显升高，且该毒素耐热，普通烹饪难以完全去除。"},
        {"title": "如何安全食用马铃薯 - 农业农村部农产品质量安全监管司", "url": "http://www.moa.gov.cn/", "domain": "moa.gov.cn", "published_at": "2023-01-08", "credibility": "A", "credibility_score": 93, "source_type": "knowledge", "org_type": "政府机构", "snippet": "建议低温避光储存马铃薯，出现发芽或表皮青紫应削除芽眼及周围组织，严重时不再食用。"}
      ]
    },
